
    OUTPUT "Enter the lower bound:"
    INPUT lower_bound

    OUTPUT "Enter the upper bound:"
    INPUT upper_bound

    WHILE lower_bound >= upper_bound
        OUTPUT "The lower bound must be less than the upper bound."

        OUTPUT "Enter the lower bound:"
        INPUT lower_bound

        OUTPUT "Enter the upper bound:"
        INPUT upper_bound
    END WHILE

    SET random_number = RANDOM(lower_bound, upper_bound)

    OUTPUT "Guess a number between the lower bound and upper bound:"
    INPUT guess

    WHILE guess < lower_bound OR guess > upper_bound
        OUTPUT "Your guess must be between the lower and upper bounds."
        INPUT guess
    END WHILE

    WHILE guess != random_number

        IF guess < random_number
            OUTPUT "Nope, too low."
        ELSE
            OUTPUT "Nope, too high."
        END IF

        OUTPUT "Guess another number:"
        INPUT guess

        WHILE guess < lower_bound OR guess > upper_bound
            OUTPUT "Your guess must be between the lower and upper bounds."
            INPUT guess
        END WHILE

    END WHILE

    OUTPUT "You got it!"
